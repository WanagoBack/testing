+
+/* Native WanagoBack entry point, called from the rendering thread after Vid_init. */
+bool Vid_wgb_open(const char* name,const char* directory)
+{
+ if(!name||!directory||!Vid_query_init_flag())return false;
+ Vid_file* file_data=calloc(1,sizeof(Vid_file));
+ if(!file_data)return false;
+ if(strlen(name)>=sizeof(file_data->name)||strlen(directory)>=sizeof(file_data->directory)){free(file_data);return false;}
+ snprintf(file_data->name,sizeof(file_data->name),"%s",name);
+ snprintf(file_data->directory,sizeof(file_data->directory),"%s",directory);
+ file_data->index=0;
+ uint32_t result=Util_queue_add(&vid_player.decode_thread_command_queue,DECODE_THREAD_PLAY_REQUEST,file_data,QUEUE_OP_TIMEOUT_US,QUEUE_OPTION_NONE);
+ if(result!=DEF_SUCCESS){free(file_data);return false;}
+ return true;
+}
