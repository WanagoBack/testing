+   Vid_command next=DECODE_THREAD_RESUME_REQUEST;
+   if(vid_player.state==PLAYER_STATE_IDLE)next=DECODE_THREAD_PLAY_REQUEST;
+   else if(vid_player.state==PLAYER_STATE_PLAYING || (vid_player.sub_state&PLAYER_SUB_STATE_RESUME_LATER))next=DECODE_THREAD_PAUSE_REQUEST;
