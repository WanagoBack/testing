+ if(wgb_video_attached && !aptShouldJumpToHome() && !Util_err_query_show_flag())
+ {
+  double value=0;int command=Wgb_video_input(key,&value);
+  if(command==2){
+   Util_queue_add(&vid_player.decode_thread_command_queue,DECODE_THREAD_ABORT_REQUEST,NULL,QUEUE_OP_TIMEOUT_US,QUEUE_OPTION_SEND_TO_FRONT);
